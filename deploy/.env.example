DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=todo.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://todo.example.com
DJANGO_TIME_ZONE=UTC
# Set only to your reverse proxy's actual source IP/CIDR after configuring it
# to overwrite X-Real-IP. Leave empty for direct connections.
AUTH_TRUSTED_PROXIES=

# Opt in only after configuring your SMTP provider (STARTTLS, usually port 587).
MAIL_ENABLED=false
PUBLIC_BASE_URL=https://todo.example.com
DEFAULT_FROM_EMAIL=Daymark <noreply@example.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional HTTPS endpoint accepting the minimal JSON event described in docs/operations.md.
ERROR_WEBHOOK_URL=
